Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1.0
      Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Alpha: 1.0
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Value: true
    - Alpha: 1.0
      Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frames:
        base_footprint:
          Value: true
        base_link:
          Value: true
        camera_link:
          Value: true
        front_left_steering_link:
          Value: true
        front_right_steering_link:
          Value: true
        front_left_wheel:
          Value: true
        front_right_wheel:
          Value: true
        rear_left_wheel:
          Value: true
        rear_right_wheel:
          Value: true
        imu_link:
          Value: true
      Marker Scale: 0.5
      Name: TF
      Show Axes: true
      Show Names: false
      Tree:
        base_footprint:
          base_link:
            camera_link:
            front_left_steering_link:
              front_left_wheel:
              front_right_steering_link:
                front_right_wheel:
            rear_left_wheel:
            rear_right_wheel:
            imu_link:
      Update Interval: 0
      Value: true
    - Alpha: 1.0
      Class: rviz_default_plugins/Path
      Name: Actual Path
      Topic:
        Value: /actual_path
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_footprint
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
      Name: Interact
    - Class: rviz_default_plugins/MoveCamera
      Name: Move Camera
    - Class: rviz_default_plugins/Select
      Name: Select
    - Class: rviz_default_plugins/FocusCamera
      Name: Focus Camera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
      Name: Measure
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Name: Publish Point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505836
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.00999999977648258
      Pitch: 0.6097970008850098
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.5103846192359924
    Saved: ~
  Window Geometry:
    Height: 846
    Width: 1200
    X: 201
    Y: 69
  Name: root
  View Namespace: ""
  Displays Tree:
    Grid1:
      Values: []
    RobotModel1:
      Values: []
    TF1:
      Values: []
    Actual Path1:
      Values: []
    Height: 400
    Name: Displays
    Width: 560
    collapsed: false
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
    Height: 400
    Width: 200
  Tools:
    collapsed: false
    Height: 400
    Width: 200
  Views:
    collapsed: false
    Height: 400
    Width: 200
  User Data:
    collapsed: false
