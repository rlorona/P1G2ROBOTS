<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Gazebo materials and contact ===================== -->
  <gazebo reference="base_link">
    <material>Gazebo/Silver</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <self_collide>false</self_collide>
    <gravity>true</gravity>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="front_left_steering_link">
    <material>Gazebo/DarkGrey</material>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="front_right_steering_link">
    <material>Gazebo/DarkGrey</material>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="front_left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="front_right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="rear_left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="rear_right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <!-- ===================== IMU sensor ===================== -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ===================== ros2_control Gazebo plugin ===================== -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find proyecto_rm_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ===================== Ground-truth odometry ===================== -->
  <!-- Publishes /model/proyecto_rm/odometry in Gazebo. It is bridged to ROS
       as /ground_truth/odometry for error analysis. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>

</robot>
